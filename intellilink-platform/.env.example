# ============================================
# Intellilink NOG Platform - Environment Config
# ============================================

# --- Application ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=intellilink
DATABASE_USER=intellilink
DATABASE_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://intellilink:change_me_in_production@localhost:5432/intellilink

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change_this_to_a_random_64_char_string_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_REFRESH_EXPIRATION=7d

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8100
AI_PROVIDER=ollama
AI_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Telemetry ---
TELEMETRY_SECRET=telemetry_ingestion_secret_change_me

# --- Prometheus ---
PROMETHEUS_URL=http://localhost:9090

# --- Logging ---
LOG_LEVEL=info
LOKI_URL=http://localhost:3100

# --- Simulator ---
SIMULATOR_ENABLED=true
SIMULATOR_TICK_INTERVAL_MS=5000

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
